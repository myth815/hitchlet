# Local single-container deployment
PORT=3000
LOG_LEVEL=info
# Native development: execution is disabled by default. For M0, use the
# explicit loopback Simulator launch in docs/runbook.md. Compose keeps secure
# cookies and disabled execution; Docker uses compose.portainer.yaml after setup.
EXECUTION_MODE=disabled
# EXECUTION_MODE=simulator
# SIMULATOR_DATA_DIR=./simulator-data
# Compose Docker override only; key must be readable by container UID 1000 and
# protected from other users. This is a path, never the master-key value.
# HITCHLET_MASTER_KEY_HOST_FILE=/srv/hitchlet-key/master.key
# Keep disabled while registering real resources with loaded secret refs.
# HITCHLET_DOCKER_EXECUTION_MODE=disabled
DISK_LOW_WATER_MIB=1024
DISK_RESERVE_MIB=128
IMAGE_PULL_BUDGET_MIB=8192
BACKUP_DAILY_COPIES=7
BACKUP_WEEKLY_COPIES=4
LOG_MAX_BYTES=10485760
LOG_FILES=5
