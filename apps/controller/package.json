{
  "name": "@hitchlet/controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "typecheck": "pnpm --filter @hitchlet/contracts build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @hitchlet/contracts build && pnpm build && vitest run",
    "dev": "node scripts/dev-watch.mjs",
    "init:simulator": "pnpm --filter @hitchlet/contracts build && pnpm build && node dist/init-simulator.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "@hitchlet/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "files": [
    "dist",
    "package.json"
  ]
}
