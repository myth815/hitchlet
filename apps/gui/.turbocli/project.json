{
  "protocolVersion": "1.0",
  "featureRoom": {
    "scope": {
      "implementation": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.test.ts"
      ],
      "tests": ["src/**/*.test.{ts,tsx}"],
      "assets": [
        "src/**/*.css",
        "index.html",
        "package.json",
        "tsconfig.json",
        "vite.config.ts"
      ]
    },
    "shared": [
      "src/format.ts",
      "src/ManagementUI.tsx",
      "src/Management.test.tsx"
    ],
    "projectLevel": [
      "src/App.tsx",
      "src/main.tsx",
      "src/style.css",
      "index.html",
      "package.json",
      "tsconfig.json",
      "vite.config.ts"
    ],
    "exclude": []
  }
}
