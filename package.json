{
  "name": "hitchlet",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @hitchlet/contracts build && pnpm --filter @hitchlet/sdk build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "node scripts/dev.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
