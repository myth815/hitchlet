{
  "name": "@hitchlet/sdk",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/**",
    "README.md",
    "examples/**"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs @hitchlet/sdk && tsc -p tsconfig.json && node ../../scripts/package-provenance.mjs @hitchlet/sdk",
    "typecheck": "pnpm --filter @hitchlet/contracts build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @hitchlet/contracts build && vitest run"
  },
  "dependencies": {
    "@hitchlet/contracts": "workspace:0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
